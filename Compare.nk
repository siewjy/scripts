set cut_paste_input [stack 0]
version 10.0 v5
push $cut_paste_input
push 0
Group {
inputs 2
name Compare
tile_color 0xdb00ff
gl_color 0xff
note_font "Bitstream Vera Sans"
selected true
xpos 1893
ypos 969
addUserKnob {20 User}
addUserKnob {26 Tooltips l "" +STARTLINE T "Improved Difference Key -
siewjy "}
addUserKnob {41 AdjustMatte l adjustMatte T NoOp1.AdjustMatte}
addUserKnob {41 fillhole l FillHole T NoOp2.fillhole}
}
Input {
inputs 0
name A
xpos 392
ypos 450
number 1
}
Input {
inputs 0
name B
xpos 635
ypos 448
}
Compare {
inputs 2
name Compare2
xpos 510
ypos 533
}
Keyer {
operation "luminance key"
range {0 1e-05 1 1}
name Keyer1
xpos 510
ypos 594
}
Erode {
channels alpha
size {{Compare.NoOp1.expandMatte-2}}
blur -1
name Erode1
xpos 510
ypos 648
}
Shuffle {
red alpha
green alpha
blue alpha
name Shuffle1
label "Channel in \[value in]"
xpos 510
ypos 717
}
Dilate {
size {{Compare.NoOp2.fillhole}}
name Dilate1
label "Size: \[value size]"
xpos 510
ypos 781
}
Dilate {
size {{Compare.NoOp2.fillhole-Compare.NoOp2.fillhole*2}}
name Dilate2
label "Size: \[value size]"
xpos 510
ypos 861
}
Output {
name Output1
xpos 510
ypos 961
}
NoOp {
inputs 0
name NoOp2
xpos 754
ypos 793
addUserKnob {20 User}
addUserKnob {7 fillhole l FillHole R 0 25}
}
NoOp {
inputs 0
name NoOp1
selected true
xpos 752
ypos 655
addUserKnob {20 User}
addUserKnob {7 expandMatte R -2 4}
expandMatte {{Compare.NoOp1.AdjustMatte-Compare.NoOp1.AdjustMatte*2}}
addUserKnob {7 AdjustMatte l adjustMatte R 0 10}
}
end_group
